# ============================================
# Ghost 博客系统环境配置示例
# 复制此文件为 .env 并修改对应值
# ============================================

# 运行环境：production / development / testing
NODE_ENV=development

# 服务端口
PORT=2368

# 数据库配置（本地开发使用SQLite，无需配置）
# 生产环境MySQL配置示例：
# database__client=mysql
# database__connection__host=localhost
# database__connection__user=ghost
# database__connection__password=your_password
# database__connection__database=ghost

# 邮件配置（可选，用于会员注册通知）
# mail__transport=SMTP
# mail__options__service=Gmail
# mail__options__auth__user=your_email@gmail.com
# mail__options__auth__pass=your_app_password

# 站点URL
url=http://localhost:2368

# 管理员初始配置（首次启动时使用）
# admin__email=admin@example.com
# admin__password=your_secure_password

# 隐私与统计
privacy__useRpcPing=false
privacy__useUpdateCheck=false
