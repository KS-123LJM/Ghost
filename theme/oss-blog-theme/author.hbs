{{!< default}}

{{!-- Author archive page --}}
<div class="site-header-content outer">
    <div class="site-header-inner inner">
        {{#if profile_image}}
            <img class="author-profile-image" src="{{img_url profile_image size="m"}}" alt="{{name}}" />
        {{/if}}
        <h1 class="site-title">{{name}}</h1>
        {{#if bio}}
            <p class="site-description">{{bio}}</p>
        {{/if}}
    </div>
</div>

<main id="site-main" class="site-main outer">
<div class="inner posts">
    <div class="post-feed">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </div>
    {{pagination}}
</div>
</main>
